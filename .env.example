# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_VERSION=v1
GEMINI_MODEL=gemini-2.5-flash

# --- Groq AI (Primary model for LaTeX generation) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# --- Supabase ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Server ---
PORT=3000

# --- Remote LaTeX Compiler ---
# Set this to your Render backend URL + /api/compile
LATEX_COMPILER_URL=https://your-app-name.onrender.com/api/compile
